          "@type": "SlotDefinition"
        },
        {
          "name": "sampling_method",
          "description": "Sampling method for terrestrial samples",
          "in_subset": [
            "mandatory"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Terrestrial",
      "@type": "ClassDefinition"
    },
    {
      "name": "Biota",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Biota",
      "description": "Biota sample",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "is_a": "Sample",
      "slots": [
        "site_name",
        "site_id",
        "Sample_sample_id",
        "start_date",
        "end_date",
        "sampling_time_start",
        "sampling_time_end",
        "sample__domain",
        "sample__observations",
        "biota__matrix",
        "biota__sampling_method",
        "biota__compartment",
        "biota__gender",
        "biota__life_stage_age",
        "biota__taxonomic_classification"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "matrix",
          "description": "Sampled matrix",
          "in_subset": [
            "mandatory"
          ],
          "range": "MatrixBiota",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "sampling_method",
          "description": "Sampling method for biota samples (to be discussed)",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "compartment",
          "description": "The environmental compartment where the organism was sampled from.",
          "range": "EnvironmentalCompartment",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gender",
          "description": "Collected organism gender",
          "range": "Gender",
          "@type": "SlotDefinition"
        },
        {
          "name": "life_stage_age",
          "description": "Life stage or age of the organism",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "taxonomic_classification",
          "description": "A taxonomic entity identified in a biological sample, referenced against the GBIF Backbone Taxonomy.",
          "range": "Taxon",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Biota",
      "@type": "ClassDefinition"
    },
    {
      "name": "Taxon",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Taxon",
      "description": "A taxonomic entity identified in a biological sample, referenced against the GBIF Backbone Taxonomy.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "see_also": [
        "https://www.gbif.org/species/search"
      ],
      "slots": [
        "taxon__taxon_id",
        "taxon__taxon_name",
        "taxon__taxon_rank"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "taxon_id",
          "description": "GBIF species key (integer). Resolves to https://www.gbif.org/species/{taxon_id}",
          "in_subset": [
            "mandatory"
          ],
          "see_also": [
            "https://www.gbif.org/species/search"
          ],
          "identifier": true,
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "taxon_name",
          "description": "Scientific name of the taxon (genus, species or higher rank) as accepted in the GBIF Backbone Taxonomy.",
          "in_subset": [
            "mandatory"
          ],
          "see_also": [
            "https://www.gbif.org/species/search"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "taxon_rank",
          "description": "Taxonomic rank of the identified taxon.",
          "see_also": [
            "https://www.gbif.org/developer/species#rank"
          ],
          "range": "TaxonRankEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Taxon",
      "@type": "ClassDefinition"
    },
    {
      "name": "Observation",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Observation",
      "description": "Abstract base class for all observations associated with a sample. Every observation must be either a MeasurementConcentration or a MeasurementParameter. Contains shared slots (unit, uncertainty, value) common to all observation types.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "abstract": true,
      "slots": [
        "sample_id",
        "unit",
        "uncertainty",
        "value",
        "observation__observation_type"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "observation_type",
          "description": "Type of measurement/observation: i) Chemical concentration in the environment or biota - main observation and; ii) Other parameters - they give context to the main measurement.",
          "in_subset": [
            "mandatory"
          ],
          "designates_type": true,
          "range": "ObservationType",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Observation",
      "@type": "ClassDefinition"
    },
    {
      "name": "MeasurementConcentration",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/MeasurementConcentration",
      "description": "A measured concentration of a chemical compound in a sample. At least one of concentration, LOQ, or LOD must be provided.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "is_a": "Observation",
      "slots": [
        "sample_id",
        "unit",
        "uncertainty",
        "value",
        "observation__observation_type",
        "measurementConcentration__laboratory",
        "measurementConcentration__batch",
        "measurementConcentration__analysis_date",
        "measurementConcentration__compound",
        "measurementConcentration__sample_preparation_method",
        "measurementConcentration__sample_preparation_method_link",
        "measurementConcentration__analytical_method",
        "measurementConcentration__analytical_method_link",
        "measurementConcentration__data_handling_procedure",
        "measurementConcentration__data_handling_procedure_link",
        "measurementConcentration__loq",
        "measurementConcentration__lod"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "laboratory",
          "description": "Name of the laboratory performing the analysis",
          "in_subset": [
            "mandatory"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "batch",
          "description": "Internal laboratory designation of the group of samples analyzed together",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "analysis_date",
          "description": "The date on which the concentration was determined",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "compound",
          "description": "Chemical compound measured in the sample. Reference to the PARC WP9 compound list entry (ChemicalCompound class). Identified by WP9_id, name, CAS, EC, InChI, and InChIKey. Mappable to ChEBI, PubChem, and NORMAN identifiers. A single measurement record should typically correspond to one compound.",
          "in_subset": [
            "mandatory"
          ],
          "range": "ChemicalCompound",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "sample_preparation_method",
          "description": "Description of the process from sample collection to chemical analysis (e.g., extraction, cleanup, fractionation).",
          "in_subset": [
            "mandatory"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "sample_preparation_method_link",
          "description": "GUPRI (e.g. DOI) linking to a public SOP, article, or other document describing the method.",
          "range": "IRI",
          "@type": "SlotDefinition"
        },
        {
          "name": "analytical_method",
          "description": "Analytical method used to determine the analyte",
          "in_subset": [
            "mandatory"
          ],
          "range": "AnalyticalMethod",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "analytical_method_link",
          "description": "GUPRI linking to a public SOP or document describing the method",
          "range": "IRI",
          "@type": "SlotDefinition"
        },
        {
          "name": "data_handling_procedure",
          "description": "Description of steps taken after chemical analysis (e.g., blank correction, quality control, calibration, recovery, standardization, recalculations).",
          "in_subset": [
            "mandatory"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "data_handling_procedure_link",
          "description": "GUPRI linking to a document describing the data handling procedure",
          "range": "IRI",
          "@type": "SlotDefinition"
        },
        {
          "name": "loq",
          "description": "Limit of quantification",
          "range": "double",
          "@type": "SlotDefinition"
        },
        {
          "name": "lod",
          "description": "Limit of detection",
          "range": "double",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/MeasurementConcentration",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "value",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "loq",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "lod",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "value",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "At least one of concentration value (value), LOQ, or LOD  must be provided per measurement record. This rule creates a logical contradiction when all three are absent, making that state invalid. The postcondition on value is  conventional \u2014 any of the three would work equivalently.",
          "title": "at_least_one_measurement_value_required",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "MeasurementParameter",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/MeasurementParameter",
      "description": "An additional parameter measured in the sample (e.g. pH, temperature, TOC). Depends on matrix type.  Gives context to the chemical concentration measurement.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "is_a": "Observation",
      "slots": [
        "sample_id",
        "unit",
        "uncertainty",
        "value",
        "observation__observation_type",
        "measurementParameter__parameter"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "parameter",
          "description": "Name of the parameter measured. Refer to the codelist-parameter tab for the list.",
          "in_subset": [
            "mandatory"
          ],
          "range": "Parameter",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/MeasurementParameter",
      "@type": "ClassDefinition"
    },
    {
      "name": "ChemicalCompound",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/ChemicalCompound",
      "description": "A chemical compound monitored in environmental samples. The compound list (1500+ substances) was developed in PARC WP9 in collaboration with other WPs. Each compound is identified by multiple persistent identifiers and assigned to a compound group. See: https://doi.org/10.5281/zenodo.17175075",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "see_also": [
        "https://doi.org/10.1186/s13321-025-01092-3"
      ],
      "slots": [
        "chemicalCompound__wp9_id",
        "chemicalCompound__compound_name",
        "chemicalCompound__compound_group",
        "chemicalCompound__cas_number",
        "chemicalCompound__ec_number",
        "chemicalCompound__inchi",
        "chemicalCompound__inchikey",
        "chemicalCompound__chebi_id",
        "chemicalCompound__pubchem_cid",
        "chemicalCompound__norman_id"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "wp9_id",
          "description": "Internal PARC WP9 identifier for the compound. Unique within the PARC compound list.",
          "identifier": true,
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "compound_name",
          "description": "Common or abbreviated name of the compound as used in the PARC community (e.g. PFOS, triclosan).",
          "in_subset": [
            "mandatory"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "compound_group",
          "description": "Chemical group classification of the compound as defined in the PARC WP9 compound list (e.g. PFAS, biocides, PCBs, PAHs). # TODO: Future alignment planned with ChemFOnt functional classes # and/or C3PO (ChEBI Chemical Class Program Ontology)",
          "range": "CompoundGroup",
          "@type": "SlotDefinition"
        },
        {
          "name": "cas_number",
          "description": "CAS Registry Number \u2014 unique numerical identifier assigned by the Chemical Abstracts Service. Format: NNNNNN-NN-N",
          "range": "string",
          "pattern": "^\\d{2,7}-\\d{2}-\\d$",
          "@type": "SlotDefinition"
        },
        {
          "name": "ec_number",
          "description": "EC Number (European Community Number) \u2014 identifier used in the ECHA substance inventory (EINECS, ELINCS, NLP). Format: NNN-NNN-N",
          "range": "string",
          "pattern": "^\\d{3}-\\d{3}-\\d$",
          "@type": "SlotDefinition"
        },
        {
          "name": "inchi",
          "description": "IUPAC International Chemical Identifier (InChI) \u2014 a standard textual representation of the molecular structure. Begins with 'InChI=1S/'.",
          "range": "string",
          "required": true,
          "pattern": "^InChI=1S/",
          "@type": "SlotDefinition"
        },
        {
          "name": "inchikey",
          "description": "InChIKey \u2014 a fixed-length (27-character) hash of the InChI string. Used as a compact, web-searchable identifier. Format: XXXXXXXXXXXXXX-XXXXXXXXXX-X",
          "range": "string",
          "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$",
          "@type": "SlotDefinition"
        },
        {
          "name": "chebi_id",
          "description": "ChEBI identifier for the compound. To be populated by mapping from InChIKey to ChEBI. Format: CHEBI:NNNNN",
          "range": "IRI",
          "@type": "SlotDefinition"
        },
        {
          "name": "pubchem_cid",
          "description": "PubChem Compound ID (CID). To be populated by mapping from InChIKey to PubChem.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "norman_id",
          "description": "NORMAN substance identifier. Source: NORMAN EMPODAT / SusDat database.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/ChemicalCompound",
      "@type": "ClassDefinition"
    }
  ],
