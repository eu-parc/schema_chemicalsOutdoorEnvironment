          ],
          "range": "MatrixAtmospheric",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "sampling_method",
          "description": "Method used to collect the sample",
          "in_subset": [
            "mandatory"
          ],
          "range": "SamplingMethodAtmospheric",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Atmospheric",
      "@type": "ClassDefinition"
    },
    {
      "name": "Aquatic",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Aquatic",
      "description": "Aquatic sample",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "is_a": "Sample",
      "slots": [
        "site_name",
        "site_id",
        "Sample_sample_id",
        "start_date",
        "end_date",
        "sampling_time_start",
        "sampling_time_end",
        "sample__domain",
        "sample__observations",
        "aquatic__matrix",
        "aquatic__sampling_method",
        "aquatic__fraction"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "matrix",
          "description": "Sampled matrix",
          "in_subset": [
            "mandatory"
          ],
          "range": "MatrixAquatic",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "sampling_method",
          "description": "Method used to collect the sample",
          "in_subset": [
            "mandatory"
          ],
          "range": "SamplingMethodAquatic",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fraction",
          "description": "If the collected sample is divided into multiple fractions for separate analysis, this field identifies each subsample.",
          "range": "AquaticMatrixFraction",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Aquatic",
      "@type": "ClassDefinition"
    },
    {
      "name": "Terrestrial",
