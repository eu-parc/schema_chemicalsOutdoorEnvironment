  "types": [
    {
      "name": "EmailAddress",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/EmailAddress",
      "description": "A valid email address",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^[\\w.+-]+@[\\w-]+\\.[\\w.]+$",
      "@type": "TypeDefinition"
    },
    {
      "name": "IRI",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/IRI",
      "description": "An Internationalized Resource Identifier (IRI). All URIs are valid IRIs, so both URI and IRI values are accepted.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "@type": "TypeDefinition"
    },
    {
      "name": "OrcidIdentifier",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/OrcidIdentifier",
      "description": "An ORCID identifier in the format 0000-0000-0000-0000",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$",
      "@type": "TypeDefinition"
    },
    {
      "name": "RorIdentifier",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/RorIdentifier",
      "description": "A ROR identifier in the format ror.org/xxxxxxxxx",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^ror\\.org/[a-z0-9]{9}$",
      "@type": "TypeDefinition"
    },
    {
