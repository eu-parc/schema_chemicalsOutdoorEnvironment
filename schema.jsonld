      "definition_uri": "https://w3id.org/chemical-exposome/terms/DecimalDegree",
      "description": "A decimal degree coordinate value",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "base": "double",
      "uri": "http://www.w3.org/2001/XMLSchema#decimal",
      "@type": "TypeDefinition"
    },
    {
      "name": "YearValue",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/YearValue",
      "description": "A year value in YYYY format",
