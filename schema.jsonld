    {
      "name": "MatrixTerrestrial",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/MatrixTerrestrial",
      "description": "Matrix values valid for terrestrial samples (SampleTerrestrial). All terms are narrower than TerrestrialMatrix in the PARC environmental matrix vocabulary.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "see_also": [
        "https://w3id.org/peh/terms/TerrestrialMatrix"
      ],
      "permissible_values": [
        {
          "text": "SoilProfile",
          "description": "Composite soil profile sample covering multiple horizons",
          "meaning": "https://w3id.org/peh/matrices/SoilProfile"
        },
        {
          "text": "O_Horizon",
          "description": "O horizon \u2014 organic horizon above mineral soil, dominated by organic material in various stages of decomposition",
          "meaning": "https://w3id.org/peh/matrices/O_Horizon"
        },
        {
          "text": "A_Horizon",
          "description": "A horizon \u2014 topsoil mineral horizon with incorporated organic matter, darkened by humus",
          "meaning": "https://w3id.org/peh/matrices/A_Horizon"
        },
        {
          "text": "E_Horizon",
          "description": "E horizon \u2014 eluviation horizon, leached of clay, iron and aluminium oxides",
          "meaning": "https://w3id.org/peh/matrices/E_Horizon"
        },
        {
          "text": "B_Horizon",
          "description": "B horizon \u2014 illuviation horizon, enriched by materials leached from above",
          "meaning": "https://w3id.org/peh/matrices/B_Horizon"
        },
        {
          "text": "C_Horizon",
          "description": "C horizon \u2014 parent material horizon, unconsolidated mineral material",
          "meaning": "https://w3id.org/peh/matrices/C_Horizon"
        },
        {
          "text": "R_Horizon",
          "description": "R horizon \u2014 bedrock, consolidated hard rock",
          "meaning": "https://w3id.org/peh/matrices/R_Horizon"
        },
        {
          "text": "S_Horizon",
          "description": "S horizon \u2014 salic horizon, enriched with soluble salts",
          "meaning": "https://w3id.org/peh/matrices/S_Horizon"
        },
        {
          "text": "H_Horizon",
          "description": "H horizon \u2014 histic horizon, organic horizon that is saturated with water for prolonged periods",
          "meaning": "https://w3id.org/peh/matrices/H_Horizon"
        }
      ]
    },
