  "classes": [
    {
      "name": "MonitoringActivity",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/MonitoringActivity",
      "description": "A research project or monitoring programme collecting environmental data on chemicals in the outdoor environment (air, water, sediment, soil, biota)",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slots": [
        "name_en",
        "name_original",
        "MonitoringActivity_acronym",
        "monitoringActivity__type",
        "monitoringActivity__activity_description",
        "monitoringActivity__activity_identifier",
        "monitoringActivity__monitoring_reasons",
        "monitoringActivity__legislation_policy",
        "monitoringActivity__implementation_level",
        "monitoringActivity__language",
        "monitoringActivity__start_date",
        "monitoringActivity__end_date",
        "monitoringActivity__campaigns",
        "monitoringActivity__institutions",
        "monitoringActivity__contacts",
        "monitoringActivity__funders",
        "monitoringActivity__access_procedures",
        "monitoringActivity__acknowledgement",
        "monitoringActivity__license",
        "monitoringActivity__disclaimer",
        "monitoringActivity__version",
        "monitoringActivity__publication_year",
        "monitoringActivity__provenance",
        "monitoringActivity__sites"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "type",
          "description": "Type of monitoring activity",
          "in_subset": [
            "mandatory"
          ],
          "range": "MonitoringActivityType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "activity_description",
          "description": "A brief summary with the most important details summarising the project (objectives, scope, target group, key aspects, design, methods).",
          "in_subset": [
            "mandatory"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "activity_identifier",
          "description": "Project/monitoring programme identifier provided as URL (GUPRI). At least one identifier required.",
          "range": "IRI",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "monitoring_reasons",
          "description": "Primary reasons for performing monitoring (e.g. regulatory requirements). Mandatory for monitoring programmes; optional for projects if relevant.",
          "in_subset": [
            "mandatory_if"
          ],
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "legislation_policy",
          "description": "Link(s) to policy, convention, or legislation underpinning the monitoring activity. Mandatory for monitoring programmes; optional for projects if relevant. ",
          "in_subset": [
            "mandatory_if"
          ],
          "range": "IRI",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "implementation_level",
          "description": "The geographic scale of the monitoring coverage (international, national, regional, or local).",
          "range": "ImplementationLevel",
          "@type": "SlotDefinition"
        },
        {
          "name": "language",
          "description": "Language(s) used, as 2-letter codes according to ISO 639-1.",
          "range": "Language",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "start_date",
          "description": "The beginning (or previewed starting) date of the monitoring programme/project.",
          "in_subset": [
            "mandatory"
          ],
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "end_date",
          "description": "End date of the project/monitoring programme.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "campaigns",
          "description": "If an Environmental Monitoring Programme/Project has a long-term perspective of at least  a few years, it may be necessary to input data at suitable time intervals. For this time period,  is used the term \"Campaign\". A Campaign is defined by its start and end, and it is recommended  to name it within the project using a consistent style.",
          "range": "Campaign",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "institutions",
          "description": "Institution(s) responsible for implementing the monitoring activity.",
          "in_subset": [
            "mandatory"
          ],
          "range": "Institution",
          "required": true,
          "multivalued": true,
          "inlined_as_list": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "contacts",
          "description": "Contact person(s) for the monitoring activity.",
          "in_subset": [
            "mandatory"
          ],
          "range": "Contact",
          "required": true,
          "multivalued": true,
          "inlined_as_list": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "funders",
          "description": "Funding entity/entities supporting the monitoring activity.",
          "range": "Funder",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "access_procedures",
          "description": "Information on procedure to obtain access to the dataset.",
          "in_subset": [
            "mandatory"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "acknowledgement",
          "description": "Text for acknowledgement which should be reported when using/re-using the data.",
          "in_subset": [
            "mandatory"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "license",
          "description": "License or terms for data reuse.",
          "in_subset": [
            "mandatory"
          ],
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "disclaimer",
          "description": "Text for disclaimer when using/re-using the data.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "version",
          "description": "Version of the dataset.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "publication_year",
          "description": "Year when the dataset was or will be made publicly available.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "provenance",
          "description": "A statement about the lineage of the dataset.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "sites",
          "description": "Monitoring site(s) associated with this project or monitoring programme.",
          "range": "Site",
          "required": true,
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/MonitoringActivity",
      "tree_root": true,
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "type",
                "equals_string": "monitoring_programme",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "monitoring_reasons",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Monitoring reasons are mandatory when the monitoring activity type is a monitoring programme, as it is driven by legislative requirements that must be explicitly documented.",
          "title": "monitoring_reasons_required_for_monitoring_programme",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "type",
                "equals_string": "monitoring_programme",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "legislation_policy",
                "required": true,
                "minimum_cardinality": 1,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "At least one link to legislation or policy is mandatory when the activity type is a monitoring programme.",
          "title": "legislation_policy_required_for_monitoring_programme",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Campaign",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Campaign",
      "description": "A time-bounded data collection period within a project or monitoring programme. Mandatory if the campaign exists.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slots": [
        "Campaign_name_en",
        "Campaign_acronym",
        "start_date",
        "Campaign_end_date",
        "campaign__campaign_description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "campaign_description",
          "description": "Description of the campaign",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Campaign",
      "@type": "ClassDefinition"
    },
    {
      "name": "OrganisationMetadata",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/OrganisationMetadata",
      "description": "Shared metadata for organisations \u2014 institutions and funders.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "mixin": true,
      "slots": [
        "name_en",
        "name_original",
        "ror",
        "link"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/chemical-exposome/terms/OrganisationMetadata",
      "@type": "ClassDefinition"
    },
    {
      "name": "Institution",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Institution",
      "description": "Institution",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "mixins": [
        "OrganisationMetadata"
      ],
      "slots": [
        "acronym",
        "country",
        "institution__institution_id",
        "name_en",
        "name_original",
        "ror",
        "link"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "institution_id",
          "description": "Unique institution id",
          "identifier": true,
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Institution",
      "@type": "ClassDefinition"
    },
    {
      "name": "Funder",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Funder",
      "description": "Funder",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "mixins": [
        "OrganisationMetadata"
      ],
      "slots": [
        "funder__funder_id",
        "name_en",
        "name_original",
        "ror",
        "link"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "funder_id",
          "description": "Unique funder ID",
          "identifier": true,
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Funder",
      "@type": "ClassDefinition"
    },
    {
      "name": "Contact",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Contact",
      "description": "A contact person associated with the monitoring activity.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slots": [
        "email",
        "orcid",
        "contact__contact_id",
        "contact__role",
        "contact__institution"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "contact_id",
          "description": "Unique contact ID",
          "identifier": true,
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "role",
          "description": "Role/function performed by the contact person. Source: ISO 19115:2003/19139 and EC Regulation No 1205/2008 (INSPIRE).",
          "range": "Role",
          "@type": "SlotDefinition"
        },
        {
          "name": "institution",
          "description": "Contact's institution",
          "range": "Institution",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Contact",
      "@type": "ClassDefinition"
    },
    {
      "name": "Site",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Site",
      "description": "A monitoring site or location where samples are collected. Coordinates (latitude and longitude) are mandatory unless they cannot be provided for privacy, security or confidentiality reasons. When coordinates are provided, GIS-derived fields (NUTS3, land use, river basin, sea, soil type) can be automatically retrieved from GIS layers. When coordinates are not provided, expert-described location fields (country, geographic region, NUTS3) are required instead.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slots": [
        "acronym",
        "Site_country",
        "Site_site_id",
        "site_name",
        "link",
        "site__coordinate_privacy_exception",
        "site__coordinate_privacy_exception_reason",
        "site__samples",
        "site__latitude",
        "site__longitude",
        "site__coordinate_system",
        "site__geographic_region",
        "site__regional_group",
        "site__nuts3",
        "site__year_established",
        "site__site_description",
        "site__managing_instance",
        "site__water_type",
        "site__water_geographical_feature",
        "site__water_treatment",
        "site__altitude",
        "site__land_use",
        "site__river_basin",
        "site__sea",
        "site__soil_type"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "coordinate_privacy_exception",
          "description": "Set to true (value = true) if coordinates cannot be provided for privacy, security or confidentiality reasons. If true, expert location fields (country, geographic_region, nuts3) are required instead.  Optional - if not provided, it is assumed coordinates are not withheld for privacy reasons.",
          "ifabsent": "false",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "coordinate_privacy_exception_reason",
          "description": "Justification for not providing coordinates. Required when coordinate_privacy_exception is true. Provide a brief explanation of the privacy, security or confidentiality reason that prevents disclosure of the exact site location.",
          "in_subset": [
            "mandatory_if"
          ],
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "samples",
          "description": "Samples collected at this monitoring site.",
          "range": "Sample",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "latitude",
          "description": "Latitude in signed decimal degrees (format 0.000000, range -90 to 90). South latitude with minus sign. Coordinate reference system: WGS 84 (EPSG:4326). Mandatory unless coordinate_privacy_exception is true.",
          "in_subset": [
            "mandatory_if"
          ],
          "range": "DecimalDegree",
          "minimum_value": -90,
          "maximum_value": 90,
          "@type": "SlotDefinition"
        },
        {
          "name": "longitude",
          "description": "Longitude in signed decimal degrees (format 0.000000, range -180 to 180). West longitude with minus sign. Coordinate reference system: WGS 84 (EPSG:4326). Mandatory unless coordinate_privacy_exception is true.",
          "in_subset": [
            "mandatory_if"
          ],
          "range": "DecimalDegree",
          "minimum_value": -180,
          "maximum_value": 180,
          "@type": "SlotDefinition"
        },
        {
          "name": "coordinate_system",
          "description": "Coordinate reference system used. Default is EPSG:4326 (WGS 84).",
          "in_subset": [
            "mandatory_if"
          ],
          "range": "CoordinateSystem",
          "@type": "SlotDefinition"
        },
        {
          "name": "geographic_region",
          "description": "UN M49 geographic region",
          "in_subset": [
            "mandatory_if"
          ],
          "range": "GeographicRegion",
          "@type": "SlotDefinition"
        },
        {
          "name": "regional_group",
          "description": "Regional group of United Nations member states",
          "in_subset": [
            "mandatory_if"
          ],
          "range": "UNRegionalGroup",
          "@type": "SlotDefinition"
        },
        {
          "name": "nuts3",
          "description": "NUTS3 region code according to the Eurostat NUTS classification (Nomenclature of Territorial Units for Statistics), level 3. Example: CZ080 (Moravskoslezsky kraj), DE300 (Berlin). If NUTS3 is not applicable (e.g. non-EU countries), use an alternative administrative classification.",
          "in_subset": [
            "mandatory_if"
          ],
          "see_also": [
            "http://data.europa.eu/nuts/"
          ],
          "range": "string",
          "pattern": "^[A-Z]{2}[A-Z0-9]{3,4}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "year_established",
          "description": "Year of establishment of the monitoring station (YYYY)",
          "range": "YearValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "site_description",
          "description": "Description of the site where samples were collected. Provide all important information that cannot be captured in other fields.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "managing_instance",
          "description": "The institution that manages the sampling site",
          "range": "Institution",
          "@type": "SlotDefinition"
        },
        {
          "name": "water_type",
          "description": "Type of water body at the site. Only relevant for water and sediment sampling.",
          "range": "WaterType",
          "@type": "SlotDefinition"
        },
        {
          "name": "water_geographical_feature",
          "description": "Geographical water feature type at the site. Only relevant for water and sediment sampling.",
          "range": "WaterGeographicalFeature",
          "@type": "SlotDefinition"
        },
        {
          "name": "water_treatment",
          "description": "Water treatment status at the site. Only relevant for water and sediment sampling.",
          "range": "WaterTreatment",
          "@type": "SlotDefinition"
        },
        {
          "name": "altitude",
          "description": "Altitude in meters above sea level (MSL). Use positive values for above and negative for below sea level.",
          "range": "double",
          "@type": "SlotDefinition"
        },
        {
          "name": "land_use",
          "description": "Land use classification according to CORINE Land Cover nomenclature.",
          "see_also": [
            "https://www.w3.org/2015/03/corine"
          ],
          "range": "LandUse",
          "@type": "SlotDefinition"
        },
        {
          "name": "river_basin",
          "description": "River basin associated with the site, based on the EEA river basin districts dataset. Only relevant for water and sediment sampling.",
          "see_also": [
            "https://www.eea.europa.eu/en/datahub/datahubitem-view/dc1b1cdf-5fa0-4535-8c89-10cc051e00db"
          ],
          "range": "RiverBasin",
          "@type": "SlotDefinition"
        },
        {
          "name": "sea",
          "description": "Sea or ocean associated with the site, based on the Marine Regions Gazetteer. Only relevant for water and sediment sampling.",
          "see_also": [
            "https://www.marineregions.org"
          ],
          "range": "Sea",
          "@type": "SlotDefinition"
        },
        {
          "name": "soil_type",
          "description": "World Reference Base for Soil Resources (WRB) 2006/2007 Reference Soil Group at the site. Only relevant for soil sampling.",
          "see_also": [
            "https://inspire.ec.europa.eu/codelist/WRBReferenceSoilGroupValue"
          ],
          "range": "SoilTypeWRB",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Site",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "coordinate_privacy_exception",
                "equals_string": "false",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "latitude",
                "required": true,
                "@type": "SlotDefinition"
              },
              {
                "name": "longitude",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Coordinates are mandatory when coordinate_privacy_exception is false or not provided (defaults to false via ifabsent).",
          "title": "coordinates_required_when_no_privacy_exception",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "coordinate_privacy_exception",
                "equals_string": "true",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "coordinate_privacy_exception_reason",
                "required": true,
                "@type": "SlotDefinition"
              },
              {
                "name": "country",
                "required": true,
                "@type": "SlotDefinition"
              },
              {
                "name": "geographic_region",
                "required": true,
                "@type": "SlotDefinition"
              },
              {
                "name": "nuts3",
                "required": true,
                "@type": "SlotDefinition"
              },
              {
                "name": "regional_group",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "When coordinates cannot be provided for privacy or confidentiality reasons, a justification and expert location fields must be provided.",
          "title": "expert_fields_required_when_coordinates_withheld",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Sample",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Sample",
      "description": "Abstract base class for all sample types",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "abstract": true,
      "slots": [
        "site_name",
        "site_id",
        "Sample_sample_id",
        "start_date",
        "end_date",
        "sampling_time_start",
        "sampling_time_end",
        "sample__domain",
        "sample__observations"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "domain",
          "description": "Sample type according to sampled matrix:  Atmospheric for air, particles, precipitation, dust; Aquatic for water and sediment; Terrestrial for soil Biota for plants and animals",
          "in_subset": [
            "mandatory"
          ],
          "designates_type": true,
          "range": "Domain",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "observations",
          "description": "Observations (concentration measurements and parameters) associated with this sample.",
          "range": "Observation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/chemical-exposome/terms/Sample",
      "@type": "ClassDefinition"
    },
    {
      "name": "Atmospheric",
      "definition_uri": "https://w3id.org/chemical-exposome/terms/Atmospheric",
      "description": "Atmospheric sample",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "is_a": "Sample",
      "slots": [
