        "start_date",
        "end_date",
        "sampling_time_start",
        "sampling_time_end",
        "sample__domain",
        "sample__observations",
        "terrestrial__matrix",
        "terrestrial__sampling_method"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "matrix",
          "description": "Sampled matrix",
          "in_subset": [
            "mandatory"
          ],
          "range": "MatrixTerrestrial",
