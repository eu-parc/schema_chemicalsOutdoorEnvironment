      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__wp9_id",
      "description": "Internal PARC WP9 identifier for the compound. Unique within the PARC compound list.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/wp9_id",
      "identifier": true,
      "alias": "wp9_id",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "integer",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__compound_name",
      "description": "Common or abbreviated name of the compound as used in the PARC community (e.g. PFOS, triclosan).",
      "in_subset": [
        "mandatory"
      ],
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/compound_name",
      "alias": "compound_name",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__compound_group",
      "description": "Chemical group classification of the compound as defined in the PARC WP9 compound list (e.g. PFAS, biocides, PCBs, PAHs). # TODO: Future alignment planned with ChemFOnt functional classes # and/or C3PO (ChEBI Chemical Class Program Ontology)",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/compound_group",
      "alias": "compound_group",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "CompoundGroup",
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__cas_number",
      "description": "CAS Registry Number \u2014 unique numerical identifier assigned by the Chemical Abstracts Service. Format: NNNNNN-NN-N",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/cas_number",
      "alias": "cas_number",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "string",
      "pattern": "^\\d{2,7}-\\d{2}-\\d$",
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__ec_number",
      "description": "EC Number (European Community Number) \u2014 identifier used in the ECHA substance inventory (EINECS, ELINCS, NLP). Format: NNN-NNN-N",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/ec_number",
      "alias": "ec_number",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "string",
      "pattern": "^\\d{3}-\\d{3}-\\d$",
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__inchi",
      "description": "IUPAC International Chemical Identifier (InChI) \u2014 a standard textual representation of the molecular structure. Begins with 'InChI=1S/'.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/inchi",
      "alias": "inchi",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "string",
      "required": true,
      "pattern": "^InChI=1S/",
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__inchikey",
      "description": "InChIKey \u2014 a fixed-length (27-character) hash of the InChI string. Used as a compact, web-searchable identifier. Format: XXXXXXXXXXXXXX-XXXXXXXXXX-X",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/inchikey",
      "alias": "inchikey",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "string",
      "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$",
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__chebi_id",
      "description": "ChEBI identifier for the compound. To be populated by mapping from InChIKey to ChEBI. Format: CHEBI:NNNNN",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/chebi_id",
      "alias": "chebi_id",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "IRI",
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__pubchem_cid",
      "description": "PubChem Compound ID (CID). To be populated by mapping from InChIKey to PubChem.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/pubchem_cid",
      "alias": "pubchem_cid",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "chemicalCompound__norman_id",
      "description": "NORMAN substance identifier. Source: NORMAN EMPODAT / SusDat database.",
      "from_schema": "https://w3id.org/chemical-exposome/schema/chemicals-outdoor-env",
      "slot_uri": "https://w3id.org/chemical-exposome/terms/norman_id",
      "alias": "norman_id",
      "owner": "ChemicalCompound",
      "domain_of": [
        "ChemicalCompound"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
